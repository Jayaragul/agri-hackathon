# ---------------------------------------------------------------------------
# Krishi Mitra - AI harness environment template
#
# Copy this file to `.env` and fill in the values you want:
#     cp .env.example .env
#
# Every variable below is OPTIONAL. With none of them set, the app runs fully
# offline: the deterministic engine still produces every recommendation, cost,
# and correction, and the AI layer transparently falls back to its local
# providers. A missing key is the normal path, not an error.
# ---------------------------------------------------------------------------

# ###########################################################################
# !! READ THIS BEFORE PASTING A REAL KEY !!
#
# 1. VITE_* VARIABLES ARE PUBLIC.
#    Vite statically replaces every `import.meta.env.VITE_*` reference at build
#    time, so the literal value is embedded in the JavaScript bundle shipped to
#    the browser. Anyone who opens DevTools on the deployed site can read it.
#    This is a property of client-side builds, not a bug you can configure away.
#
# 2. A RAW KEY HERE IS ACCEPTABLE ONLY FOR A LOCAL HACKATHON DEMO.
#    For anything real, the key must live on a server-side proxy that the
#    browser calls, so the secret never reaches the client. Do not put a key
#    with billing attached, broad scopes, or production access in this file.
#
# 3. USE A THROWAWAY, RATE-LIMITED, RESTRICTED KEY AND ROTATE IT AFTER THE DEMO.
#
# 4. CONFIRM `.env` IS GITIGNORED BEFORE YOU CREATE IT.
#    At the time of writing, the repo's `.gitignore` contains only `.vercel`, so
#    a `.env` file WOULD be committed. Add these lines to `.gitignore` first:
#        .env
#        .env.local
#        .env.*.local
#    Commit THIS file (`.env.example`) as the template; never commit `.env`.
# ###########################################################################


# --- VITE_GEMINI_API_KEY ---------------------------------------------------
# Google AI Studio API key (https://aistudio.google.com/apikey).
#
# This is the master switch. When it is empty or absent, the harness sets
# `enabled: false` and every AI feature uses its deterministic local fallback.
#
# Default: "" (empty -> AI disabled)
VITE_GEMINI_API_KEY=


# --- VITE_GEMINI_MODEL -----------------------------------------------------
# Model id to prefer. A comma-separated list is also accepted and is treated as
# a preference chain, tried left to right. The verified defaults are always
# appended as a safety net, so a typo here degrades instead of breaking.
#
# Verified current (August 2026):
#   gemini-3.6-flash   generally available, production ready  <- default
#   gemini-3.5-flash   fallback
#
# Do NOT use gemini-2.5-flash: it shuts down 2026-10-16.
#
# Default: gemini-3.6-flash,gemini-3.5-flash
# VITE_GEMINI_MODEL=gemini-3.6-flash


# --- VITE_AI_ENABLED -------------------------------------------------------
# Hard kill switch. Set to "false" or "0" to force every AI feature onto its
# local fallback even when a valid API key is present - useful for demoing the
# offline story, for reproducible screenshots, or for saving quota.
#
# Accepted disabling values: false, 0, no, off (case-insensitive).
# Any other value (or absent) leaves AI on, provided a key exists.
# Note: this can only turn AI OFF. Setting it to "true" without a key does
# nothing, because there is nothing to call.
#
# Default: (unset -> enabled whenever a key is present)
# VITE_AI_ENABLED=true


# --- VITE_AI_TRANSPORT -----------------------------------------------------
# Which backend the harness talks to through.
#
#   adk    use the Antigravity ADK (Agent Development Kit) runtime (recommended for local demos)
#   auto   pick the best available transport (prioritizes Antigravity ADK)
#   sdk    use the @google/genai SDK
#   rest   use the zero-dependency fetch transport against the v1beta REST API
#   server use THIS APP'S OWN BACKEND (server/) as a proxy — RECOMMENDED FOR REAL DEPLOYMENTS.
#          No VITE_GEMINI_API_KEY needed at all in this mode; the server reads GEMINI_API_KEY
#          from its own environment instead, which never reaches the browser. See the
#          "Backend / persistence" section below and deploy/DEPLOY.md.
#
# Unrecognised values fall back to "auto".
#
# Default: adk
# VITE_AI_TRANSPORT=adk


# --- VITE_AI_TIMEOUT_MS ----------------------------------------------------
# Wall-clock budget in milliseconds for a single model attempt, after which the
# request is aborted and the harness falls back. Keep it short enough that a
# farmer on a weak rural connection is never left staring at a spinner.
#
# Clamped to 1000-120000. Non-numeric or non-positive values use the default.
# Raise it if you are sending large soil-report or pest photos.
#
# Default: 20000
# VITE_AI_TIMEOUT_MS=20000


# ###########################################################################
# Backend / persistence (server/) — ALL OPTIONAL. With none of these set, the
# frontend persists session data (farm profile, calendar chat) to the
# browser's own localStorage instead, and the app works identically. See
# `services/storage/BackendSessionStorage.ts` and `deploy/DEPLOY.md`.
# ###########################################################################

# --- GEMINI_API_KEY (server-side only, NOT prefixed VITE_) ------------------
# Google AI Studio key, read ONLY by server/src/routes/aiRoutes.ts. This is
# the secure counterpart to VITE_GEMINI_API_KEY above: because it has no
# VITE_ prefix, Vite never inlines it into the browser bundle. Set this AND
# VITE_AI_TRANSPORT=server (frontend) to run AI calls through your own
# backend instead of exposing a key to the client at all — the right choice
# for anything beyond a quick local demo.
#
# GOOGLE_API_KEY is also accepted as a fallback name.
#
# Accepts a comma-separated list of keys ("key1,key2,key3") to spread load across
# a shared quota — server/src/services/env.ts's pickApiKey() picks one at random
# per call. A single key works exactly as before.
#
# Default: "" (unset -> /api/ai/generate returns 503, harness falls back to local)
# GEMINI_API_KEY=

# --- GEMINI_LIVE_MODEL (server-side only) -----------------------------------
# Model(s) used to mint Crop Doctor's ephemeral Live API tokens
# (server/src/services/liveTokenService.ts). Needs a Live-capable, native-audio
# model. Uses the same GEMINI_API_KEY above — no separate key needed.
#
# Accepts a comma-separated list to override the whole fallback chain; a single
# id pins to exactly that model. Left unset, the built-in chain is:
#   gemini-3.1-flash-live-preview (current Gemini 3 generation, tried first)
#   gemini-2.5-flash-native-audio-preview-12-2025
#   gemini-2.5-flash-native-audio-preview-09-2025
# — token minting walks this chain on a model-not-found error, same discipline
# as GEMINI_MODEL's text chain.
#
# Default: (unset — uses the built-in chain above)
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# --- MEM0_API_KEY (server-side only) ----------------------------------------
# Long-term farmer memory across every agent, via mem0 (https://mem0.ai — free
# tier available, no credit card). Get a key from app.mem0.ai. Read only by
# server/src/services/memoryService.ts.
#
# Distinct from chat history: this is durable FACTS extracted across every
# conversation ("grows tomatoes on 2 acres"), used to personalise the General
# Farm Advisor and Calendar Query without replaying full transcripts.
#
# Default: "" (unset -> memory recall/record are safe no-ops; every feature
# works identically, just without cross-conversation personalisation)
# MEM0_API_KEY=

# --- GEMINI_MODEL (server-side only) ----------------------------------------
# Default model the server-side status endpoint reports. Does not affect
# which model is actually called — the frontend's model chain (VITE_GEMINI_MODEL)
# is sent with every request and the server just walks it.
#
# Default: gemini-3.6-flash
# GEMINI_MODEL=gemini-3.6-flash

# --- SARVAM_API_KEY (server-side only) --------------------------------------
# Powers Audio Mode's speech turns (speech-to-text + text-to-speech), via Sarvam
# AI (https://www.sarvam.ai — get a key at dashboard.sarvam.ai). Read only by
# server/src/services/sarvamProxy.ts; never a VITE_ variable, so it never
# reaches the browser bundle.
#
# Audio Mode's "brain" is the SAME answer-farm-question A2A skill the typed
# Farm Advisor uses — this key only buys the ears and the voice, not a second
# copy of the reasoning.
#
# Also accepts a comma-separated list of keys, picked from at random per call —
# same load-spreading behaviour as GEMINI_API_KEY above.
#
# Default: "" (unset -> /api/voice/* return 503; Audio Mode shows a friendly
# message pointing the farmer to the typed "Ask Advisor" instead)
# SARVAM_API_KEY=

# --- SARVAM_LANGUAGE (server-side only) -------------------------------------
# BCP-47-ish language code Sarvam should listen and speak in (e.g. "ta-IN" for
# Tamil, "hi-IN" for Hindi, "en-IN" for Indian English).
#
# Default: ta-IN
# SARVAM_LANGUAGE=ta-IN

# --- GOOGLE_WEATHER_API_KEY (server-side only) ------------------------------
# Powers proactive weather-based alerts (heavy rain, high wind, heat stress,
# thunderstorms) via Google Maps Platform's Weather API
# (https://developers.google.com/maps/documentation/weather — GA since June
# 2025). Get a key at console.cloud.google.com, enable "Weather API", and
# attach a billing account (a free tier of 10,000 calls/month applies; India
# is within the supported region set). Read only by
# server/src/services/weatherProxy.ts; never a VITE_ variable.
#
# The region is resolved server-side from a fixed, closed list of towns
# (server/src/services/weatherProxy.ts's REGION_COORDINATES) matching
# FarmProfileForm.tsx's region dropdown — the client can never spend this
# key's quota on an arbitrary location.
#
# Also accepts a comma-separated list of keys, picked from at random per call —
# same load-spreading behaviour as GEMINI_API_KEY above.
#
# Default: "" (unset -> /api/weather/* return 503; every proactive-alert
# surface just shows the deterministic calendar's own alerts, with no weather
# warnings mixed in — a missing key degrades gracefully, never breaks anything)
# GOOGLE_WEATHER_API_KEY=

# --- VITE_GOOGLE_MAPS_API_KEY (frontend) ------------------------------------
# Renders the real Google Map in the Digital Twin feature (src/features/digital-twin/LiveMap.tsx)
# and enables live geolocation centering. Unlike GOOGLE_WEATHER_API_KEY above, this key IS meant
# to be visible in the browser — the Maps JavaScript API loads directly from the client by design
# (ai.google.dev/maps docs: security here comes from HTTP referrer restrictions + quota on the
# Google Cloud Console key, not secrecy). You can safely reuse the SAME key value as
# GOOGLE_WEATHER_API_KEY here as long as "Maps JavaScript API" is enabled on it in Google Cloud
# Console, alongside "Weather API" — one Google Cloud API key can have multiple APIs enabled.
#
# Default: "" (unset, or the script fails to load -> LiveMap silently falls back to the existing
# hand-drawn DistrictMap.tsx SVG; nothing breaks, the feature just loses live tiles/geolocation)
# VITE_GOOGLE_MAPS_API_KEY=

# --- GCS_BUCKET_NAME (server-side only, NOT prefixed VITE_) ---------------
# Name of the Google Cloud Storage bucket the backend persists to. Read only
# by `server/`, never bundled into the frontend. Two independent prefixes
# share this one bucket:
#   sessions/**       session snapshots + calendar/advisor chat threads (JSON)
#   soil-reports/**   original uploaded soil-report photos/PDFs (binary)
#
# Default: (unset -> both fall back to an in-memory store; data is lost on
# restart, which is fine for a local dev server or a short-lived demo)
# GCS_BUCKET_NAME=

# --- AGRIDB_BUCKET_NAME (server-side only, NOT prefixed VITE_) --------------
# Name of the Google Cloud Storage bucket that gets a raw, best-effort JSON
# archive of every FarmConnect marketplace order synced in and listing
# published out (server/src/services/marketplaceStore.ts). Firestore
# (FIRESTORE_ENABLED below) stays the actual system of record the app reads
# from — this is a separate audit/export/backup trail, written under:
#   farmconnect/orders/<externalId>.json
#   farmconnect/listings/<id>.json
#
# A write failure here is only logged, never surfaces to the farmer/consumer
# making the request — this bucket is advisory, same posture as every other
# optional integration in this app.
#
# Default: (unset -> falls back to GCS_BUCKET_NAME if that's set, otherwise
# an in-memory store; either way nothing else in the app is affected)
# AGRIDB_BUCKET_NAME=agridb

# --- FIRESTORE_ENABLED (server-side only) -----------------------------------
# Enables Firestore-backed storage for data that's WRITTEN CONCURRENTLY by
# more than one process/caller — the FarmConnect marketplace's orders/listings
# (server/src/services/marketplaceStore.ts) and soil-report extraction
# metadata (server/src/routes/soilReportRoutes.ts). Unlike GCS_BUCKET_NAME,
# this is a deliberate, explicit opt-in rather than inferred from credentials
# existing: Firestore Native mode has to be created ONCE per GCP project
# before any call succeeds —
#     gcloud firestore databases create --location=<region> --type=firestore-native
# — see deploy/DEPLOY.md. Uses Application Default Credentials, same as
# GCS_BUCKET_NAME; no separate key of any kind.
#
# Accepted enabling values: true, 1, yes (case-insensitive). Anything else,
# or unset, uses an in-process fallback — every feature still works
# identically for a single instance, just without cross-instance/cross-
# restart durability for that specific data.
#
# Default: (unset -> in-memory fallback)
# FIRESTORE_ENABLED=true

# --- PORT (server-side only) ------------------------------------------------
# Port the Express server listens on. Cloud Run injects this automatically at
# deploy time — you normally never set this by hand outside local dev.
#
# Default: 8080
# PORT=8080

# --- VITE_API_BASE_URL (frontend) ------------------------------------------
# Base URL the frontend calls for session persistence. Leave empty for the
# normal single-container deploy, where the same server serves both the built
# frontend and its own `/api/*` routes (same-origin, no CORS needed). Only set
# this if the frontend and backend are deployed as two separate services.
#
# Default: "" (empty -> same-origin, i.e. relative `/api/...` calls)
# VITE_API_BASE_URL=
