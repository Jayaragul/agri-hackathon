# mem0ai declares an OPTIONAL peer dependency on @google/genai@^1.x purely for its own
# internal (unused-by-us) Gemini embedder integration. We depend on @google/genai@^2.x directly
# for Live API ephemeral tokens, which npm's strict peer resolution flags as a conflict even
# though the peer is optional and we never exercise that code path. legacy-peer-deps is the
# standard, safe way to unblock installs in exactly this situation.
legacy-peer-deps=true
